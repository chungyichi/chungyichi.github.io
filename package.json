{
  "name": "chungyichi-github-io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal bilingual blog. Write Markdown, commit, push: that publishes.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "new": "node scripts/new.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check.mjs"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
